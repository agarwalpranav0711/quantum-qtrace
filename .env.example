# Q-TRACE Core API Configuration Environment Template
# Copy this file to .env and adjust variables as required for your environment.

PROJECT_NAME=Q-TRACE
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Database Configuration (SQLite WAL mode enabled automatically for SQLite URLs)
DATABASE_URL=sqlite:///./qtrace.db

# Storage Configuration (Relative to project root or absolute path)
STORAGE_ROOT=./storage

# File Upload & Safety Constraints
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "tif", "tiff"]

# Security & CORS (JSON array format)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

